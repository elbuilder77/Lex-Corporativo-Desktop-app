# Lex Corporativo Desktop - configuración local opcional

# Días de retención de nuevos portafolios. Se aplica en el build del renderer.
VITE_CASE_RETENTION_DAYS=5

# Ruta opcional al directorio del modelo local de embeddings MiniLM.
# Este modelo sólo se usa para búsqueda RAG; la generación requiere BYOK.
LEX_EMBEDDING_MODEL_PATH=legal-runtime/models/Xenova/all-MiniLM-L6-v2

# Directorio que contiene legal_knowledge.lance. Si se configura, se usa como
# origen autoritativo y no se sustituye silenciosamente por la copia empaquetada.
LEX_ENGINE_LANCE_PATH=legal-runtime/lance_data
