# Lex Corporativo Desktop - variables locales opcionales

# La aplicacion instalada opera sin servicios cloud.
# Mantener vacio por defecto en distribuciones comerciales.

# Ruta opcional al modelo GGUF local, si se quiere sobrescribir el autodetectado.
LEX_ENGINE_MODEL_PATH=

# Ruta opcional al corpus LanceDB local, si se quiere sobrescribir el empaquetado.
LEX_ENGINE_LANCE_PATH=
