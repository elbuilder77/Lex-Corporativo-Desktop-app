# Lex Corporativo Desktop - configuración local opcional

# Días de retención de nuevos portafolios. Se aplica en el build del renderer.
VITE_CASE_RETENTION_DAYS=5

# Desactiva el mock del motor Rust durante desarrollo para reproducir la política
# fail-closed del ejecutable instalado.
LEX_DISABLE_ENGINE_MOCK=0

# Ruta absoluta o relativa (desde la raíz de la app) al archivo GGUF que debe
# abrir tanto Electron como el proceso Rust.
LEX_ENGINE_MODEL_PATH=src-rust/models/gemma-2-2b-it-Q4_K_M.gguf

# Directorio que contiene legal_knowledge.lance. Si se configura, se usa como
# origen autoritativo y no se sustituye silenciosamente por la copia empaquetada.
LEX_ENGINE_LANCE_PATH=src-rust/lance_data
